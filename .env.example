# IA de Mentax (Cloudflare Workers AI). Solo se usan en el servidor.
# Sin estas variables la app funciona igual, con preguntas locales y sin análisis.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Opcional: modelo de Workers AI (por defecto @cf/google/gemma-4-26b-a4b-it)
CF_AI_MODEL=
# Alternativa gratuita a Cloudflare: Groq (https://console.groq.com/keys).
# Sin ninguna de las dos, en Vercel se usa AI Gateway.
GROQ_API_KEY=
# Opcional: modelo de Groq (por defecto openai/gpt-oss-120b)
GROQ_MODEL=
